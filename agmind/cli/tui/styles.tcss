/* Phase J: Textual CSS для AGmindSetupApp. */

Screen {
    background: $surface;
}

#title {
    color: $accent;
    text-style: bold;
    padding: 1 2;
    text-align: center;
}

#detected-box {
    border: solid $accent;
    margin: 1 2;
    padding: 1 2;
    height: auto;
}

#detected-box .label {
    color: $text-muted;
}

#detected-box .value {
    color: $success;
    text-style: bold;
}

#form-container {
    margin: 1 2;
    padding: 1 2;
    border: solid $primary;
    height: auto;
}

Label.section {
    text-style: bold underline;
    margin-top: 1;
    color: $accent;
}

Input {
    margin: 0 0 1 0;
}

Select {
    margin: 0 0 1 0;
}

#profile-checkboxes Checkbox {
    margin: 0 1;
}

#service-checkboxes {
    height: auto;
    padding: 0 1;
}

/* Phase J.1.9: bordered tier card — visual grouping для per-service */
.tier-group {
    border: round $accent 60%;
    background: $boost;
    margin: 1 0;
    padding: 1 2;
    height: auto;
}

Label.tier-section {
    text-style: bold;
    color: $accent;
    margin: 0 0 1 0;
    padding: 0;
    width: 100%;
}

.tier-group Checkbox {
    margin: 0;
    padding: 0 1;
    height: auto;
    width: 100%;
    background: transparent;
}

.tier-group Checkbox:hover {
    background: $primary 25%;
}

.tier-group Checkbox.-on {
    color: $success;
}

#button-row {
    align: center middle;
    margin: 1 0;
    height: 3;
}

#button-row Button {
    margin: 0 1;
}

#preview-box {
    border: solid $warning;
    padding: 1 2;
    margin: 1 2;
    height: 20;
    overflow: auto;
}

Static.hint {
    color: $text-muted;
    margin: 0 0 1 0;
    padding: 0 1;
    text-style: italic;
}

#status-msg {
    margin: 1 2;
    color: $text-muted;
}

#status-msg.success { color: $success; text-style: bold; }
#status-msg.error { color: $error; text-style: bold; }
