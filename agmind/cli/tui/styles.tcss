/* Phase M4.7.3 — pip-boy refined.
 * References: charmbracelet/gum (bordered prompts), lazygit (panels),
 * huh (form wizard), k9s (dashboard) — applied via Textual primitives.
 */

$pip-bg: #0a1410;
$pip-bg-soft: #0e1c14;
$pip-fg: #00ff41;
$pip-dim: #00aa2a;
$pip-faint: #006619;
$pip-amber: #ffb000;
$pip-amber-dim: #aa7000;
$pip-red: #ff3030;

Screen {
    background: $pip-bg;
    color: $pip-fg;
}

Header {
    background: $pip-bg;
    color: $pip-amber;
    text-style: bold;
}

Footer {
    background: $pip-bg;
    color: $pip-dim;
}

/* Step indicator — full-width banner, dim divider below */
.step-header {
    background: $pip-bg;
    color: $pip-amber;
    text-style: bold;
    padding: 1 2;
    margin: 0 0 1 0;
    height: 3;
    width: 100%;
    text-align: center;
    border-bottom: heavy $pip-faint;
}

#title {
    color: $pip-amber;
    text-style: bold;
    padding: 0 1;
    text-align: center;
}

#detected-text {
    color: $pip-dim;
    background: $pip-bg-soft;
    padding: 0 2;
    margin: 0 4 1 4;
    text-align: center;
    border: tall $pip-faint;
}

/* Form container — centered с большими side margins */
#form-container {
    margin: 0 8;
    padding: 1 3;
    border: heavy $pip-faint;
    height: auto;
    background: $pip-bg;
}

/* VerticalScroll inset для всех screens */
VerticalScroll {
    padding: 1 4;
    margin: 0;
    background: $pip-bg;
}

/* Section labels — amber bold с decorative line */
Label.section {
    text-style: bold;
    margin: 1 0 0 1;
    padding: 0;
    color: $pip-amber;
}

/* Inputs */
Input {
    margin: 0 1 1 1;
    background: $pip-bg-soft;
    color: $pip-fg;
    border: tall $pip-faint;
    padding: 0 1;
}

Input:focus {
    border: tall $pip-amber;
    background: $pip-bg;
    color: $pip-fg;
}

Input.-invalid {
    border: tall $pip-red;
}

Input.-invalid:focus {
    border: tall $pip-red;
}

/* Select */
Select {
    margin: 0 1 1 1;
    background: $pip-bg;
    color: $pip-fg;
}

Select > SelectCurrent {
    background: $pip-bg-soft;
    color: $pip-fg;
    border: tall $pip-faint;
}

Select:focus > SelectCurrent {
    border: tall $pip-amber;
}

Select OptionList {
    background: $pip-bg;
    color: $pip-fg;
    border: tall $pip-fg;
}

Select OptionList > .option-list--option-highlighted {
    background: $pip-faint;
    color: $pip-fg;
    text-style: bold;
}

/* Service tier card — Pip-Boy panel */
#service-checkboxes {
    height: auto;
    padding: 0;
    margin: 0;
}

.tier-group {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 0 2;
    grid-rows: auto;
    border: heavy $pip-faint;
    background: $pip-bg;
    margin: 0 0 1 0;
    padding: 0 1 1 1;
    height: auto;
}

Label.tier-section {
    text-style: bold;
    color: $pip-amber;
    column-span: 2;
    padding: 0 1;
    margin: 0 0 1 0;
    width: 100%;
    background: $pip-bg-soft;
    border-bottom: tall $pip-faint;
}

/* Checkbox row — selected gets full-width green-bg highlight (charm/lazygit) */
.tier-group Checkbox {
    margin: 0;
    padding: 0 1;
    height: 1;
    width: 100%;
    background: $pip-bg;
    color: $pip-dim;
    border: none;
}

.tier-group Checkbox:hover {
    background: $pip-faint 40%;
    color: $pip-fg;
}

.tier-group Checkbox.-on {
    color: $pip-fg;
    text-style: bold;
    background: $pip-bg-soft;
}

.tier-group Checkbox.-on:hover {
    background: $pip-faint 50%;
}

.tier-group Checkbox:focus {
    color: $pip-amber;
    text-style: bold;
    background: $pip-faint 50%;
}

/* Navigation row — docked bottom, height 5 (3 button + 1 border + 1 padding) */
#nav-row,
#button-row,
#install-buttons {
    dock: bottom;
    align: center middle;
    height: 5;
    background: $pip-bg;
    border-top: heavy $pip-faint;
    padding: 1 2;
}

Button {
    background: $pip-bg;
    color: $pip-fg;
    border: tall $pip-fg;
    text-style: bold;
    margin: 0 2;
    min-width: 18;
    height: 3;
}

Button:hover {
    background: $pip-faint 40%;
    color: $pip-fg;
    border: tall $pip-fg;
}

Button:focus {
    background: $pip-fg 25%;
    color: $pip-amber;
    border: tall $pip-amber;
    text-style: bold;
}

Button.-primary {
    background: $pip-bg;
    color: $pip-amber;
    border: tall $pip-amber;
}

Button.-primary:hover {
    background: $pip-amber 25%;
}

Button.-primary:focus {
    background: $pip-amber 40%;
    color: $pip-bg;
    border: tall $pip-amber;
}

Button.-success {
    background: $pip-bg;
    color: $pip-fg;
    border: tall $pip-fg;
}

Button.-success:focus {
    background: $pip-fg 50%;
    color: $pip-bg;
}

Button.-error {
    background: $pip-bg;
    color: $pip-red;
    border: tall $pip-red;
}

/* Preview / log panels */
#preview-box {
    border: heavy $pip-faint;
    padding: 0 1;
    margin: 0 4;
    height: 16;
    overflow: auto;
    background: $pip-bg-soft;
    color: $pip-fg;
}

Static.hint {
    color: $pip-dim;
    margin: 0 1;
    padding: 0;
    text-style: italic;
}

/* Status line */
#status-msg {
    margin: 0 4;
    padding: 0 1;
    color: $pip-dim;
    background: $pip-bg;
}

#status-msg.success { color: $pip-fg; text-style: bold; }
#status-msg.error { color: $pip-red; text-style: bold; }

/* Confirm screen summary — bordered Pip-Boy panel */
#summary-text {
    padding: 1 2;
    background: $pip-bg-soft;
    color: $pip-fg;
    border: heavy $pip-faint;
    margin: 0 4;
}

/* Scrollbars */
* {
    scrollbar-background: $pip-bg;
    scrollbar-background-hover: $pip-bg;
    scrollbar-background-active: $pip-bg;
    scrollbar-color: $pip-faint;
    scrollbar-color-hover: $pip-dim;
    scrollbar-color-active: $pip-fg;
    scrollbar-corner-color: $pip-bg;
}

/* M5.3.1: Rule separator (Textual `Rule` widget) — heavy pip-amber line */
Rule {
    color: $pip-amber-dim;
    margin: 1 0;
}

/* M5.3.1+: per-role section header inside ModelScreen */
.model-section-header {
    color: $pip-amber;
    text-style: bold;
    padding: 0 2;
    margin: 1 0 0 0;
    width: 100%;
    background: $pip-bg-soft;
    border-bottom: heavy $pip-faint;
}

/* M5.3.2: hardware Panel (full-width, top of DomainScreen) */
#hardware-panel {
    color: $pip-fg;
    background: $pip-bg-soft;
    border: heavy $pip-amber-dim;
    padding: 1 2;
    margin: 0 4 1 4;
    width: 100%;
    height: auto;
}

/* M5.3.4: empty-state banner (ServicesScreen — 0 selected) */
.empty-banner {
    color: $pip-red;
    background: $pip-bg-soft;
    border: heavy $pip-red;
    padding: 1 2;
    margin: 1 0;
    text-align: center;
    text-style: bold;
    width: 100%;
}

.peers-banner {
    color: $pip-amber;
    background: $pip-bg-soft;
    border: heavy $pip-amber-dim;
    padding: 0 2;
    margin: 1 0;
    width: 100%;
}

/* M5.3.7: HelpScreen overlay */
#help-content {
    padding: 1 2;
    background: $pip-bg-soft;
    color: $pip-fg;
    border: heavy $pip-amber-dim;
    margin: 2 4;
}

/* M5.3.5: ConfirmScreen — `changed` field shown in amber */
.diff-changed {
    color: $pip-amber;
    text-style: bold;
}

/* Toast notifications — pip-boy palette */
Toast {
    background: $pip-bg;
    color: $pip-fg;
    border: heavy $pip-amber;
    padding: 0 2;
}

Toast.-information {
    border: heavy $pip-fg;
}

Toast.-warning {
    border: heavy $pip-amber;
    color: $pip-amber;
}

Toast.-error {
    border: heavy $pip-red;
    color: $pip-red;
}
