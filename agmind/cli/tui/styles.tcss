/* Phase M4.7: Fallout pip-boy terminal style — bright green on black,
   box-drawing borders, ASCII brackets, monospace, docked navigation. */

$pip-bg: #0a1410;
$pip-fg: #00ff41;
$pip-dim: #00aa2a;
$pip-faint: #006619;
$pip-amber: #ffb000;
$pip-red: #ff3030;
$pip-cursor: #00ff41;

Screen {
    background: $pip-bg;
    color: $pip-fg;
}

Header {
    background: $pip-bg;
    color: $pip-fg;
    text-style: bold;
}

Footer {
    background: $pip-bg;
    color: $pip-dim;
}

/* Step indicator — full-width centered banner */
.step-header {
    background: $pip-bg;
    color: $pip-amber;
    text-style: bold;
    padding: 0 2;
    margin: 0;
    height: 1;
    width: 100%;
    text-align: center;
}

#title {
    color: $pip-amber;
    text-style: bold;
    padding: 0 1;
    text-align: center;
}

#detected-text {
    color: $pip-dim;
    background: $pip-bg;
    padding: 0 1;
    margin: 0 1;
    text-align: center;
}

#form-container {
    margin: 1 4;
    padding: 1 3;
    border: heavy $pip-faint;
    height: auto;
    background: $pip-bg;
}

/* M4.7.2 — center wizard screen content (max-width ~100 cols) */
VerticalScroll {
    padding: 1 4;
    margin: 0;
    background: $pip-bg;
}

Label.section {
    text-style: bold;
    margin: 1 0 0 0;
    color: $pip-amber;
}

/* Inputs */
Input {
    margin: 0 0 1 0;
    background: $pip-bg;
    color: $pip-fg;
    border: tall $pip-faint;
}

Input:focus {
    border: tall $pip-fg;
    background: $pip-bg;
}

Input.-invalid {
    border: tall $pip-red;
}

/* Select */
Select {
    margin: 0 0 1 0;
    background: $pip-bg;
    color: $pip-fg;
}

Select > SelectCurrent {
    background: $pip-bg;
    color: $pip-fg;
    border: tall $pip-faint;
}

/* Service tier card — Fallout pip-boy panel */
#service-checkboxes {
    height: auto;
    padding: 0;
    margin: 0;
}

.tier-group {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 0 2;
    grid-rows: auto;
    border: heavy $pip-faint;
    background: $pip-bg;
    margin: 0 0 1 0;
    padding: 0 1;
    height: auto;
}

Label.tier-section {
    text-style: bold;
    color: $pip-amber;
    column-span: 2;
    padding: 0;
    margin: 0;
    width: 100%;
}

.tier-group Checkbox {
    margin: 0;
    padding: 0;
    height: 1;
    width: 100%;
    background: $pip-bg;
    color: $pip-fg;
    border: none;
}

.tier-group Checkbox:hover {
    background: $pip-faint 50%;
}

.tier-group Checkbox.-on {
    color: $pip-fg;
    text-style: bold;
}

.tier-group Checkbox.-off {
    color: $pip-dim;
}

/* Navigation bar — DOCKED bottom, never scrolls. */
#nav-row {
    dock: bottom;
    align: center middle;
    height: 5;
    background: $pip-bg;
    border-top: heavy $pip-faint;
    padding: 1 1;
}

#button-row {
    dock: bottom;
    align: center middle;
    height: 5;
    background: $pip-bg;
    border-top: heavy $pip-faint;
    padding: 1 1;
}

#install-buttons {
    dock: bottom;
    align: center middle;
    height: 5;
    background: $pip-bg;
    border-top: heavy $pip-faint;
    padding: 1 1;
}

Button {
    background: $pip-bg;
    color: $pip-fg;
    border: tall $pip-fg;
    text-style: bold;
    margin: 0 2;
    min-width: 16;
    height: 3;
}

Button:hover {
    background: $pip-faint 50%;
    color: $pip-fg;
    border: tall $pip-fg;
    text-style: bold;
}

Button:focus {
    background: $pip-fg 20%;
    color: $pip-amber;
    border: tall $pip-amber;
    text-style: bold;
}

Button.-primary {
    background: $pip-bg;
    color: $pip-amber;
    border: tall $pip-amber;
    text-style: bold;
}

Button.-primary:hover {
    background: $pip-amber 20%;
    color: $pip-amber;
}

Button.-primary:focus {
    background: $pip-amber 30%;
    color: $pip-bg;
    border: tall $pip-amber;
}

Button.-success {
    background: $pip-bg;
    color: $pip-fg;
    border: tall $pip-fg;
    text-style: bold;
}

Button.-success:hover {
    background: $pip-fg 20%;
    color: $pip-fg;
}

Button.-success:focus {
    background: $pip-fg 40%;
    color: $pip-bg;
    border: tall $pip-fg;
    text-style: bold;
}

Button.-error {
    background: $pip-bg;
    color: $pip-red;
    border: tall $pip-red;
    text-style: bold;
}

/* Preview / log panels */
#preview-box {
    border: heavy $pip-faint;
    padding: 0 1;
    margin: 0 1;
    height: 16;
    overflow: auto;
    background: $pip-bg;
    color: $pip-fg;
}

Static.hint {
    color: $pip-dim;
    margin: 0;
    padding: 0;
    text-style: italic;
}

/* Status line */
#status-msg {
    margin: 0 1;
    padding: 0 1;
    color: $pip-dim;
    background: $pip-bg;
}

#status-msg.success { color: $pip-fg; text-style: bold; }
#status-msg.error { color: $pip-red; text-style: bold; }

/* Confirm screen summary */
#summary-text {
    padding: 1 2;
    background: $pip-bg;
    color: $pip-fg;
    border: heavy $pip-faint;
    margin: 0 1;
}

/* Scrollbars */
* {
    scrollbar-background: $pip-bg;
    scrollbar-background-hover: $pip-bg;
    scrollbar-background-active: $pip-bg;
    scrollbar-color: $pip-faint;
    scrollbar-color-hover: $pip-dim;
    scrollbar-color-active: $pip-fg;
}
