/* Phase J.1.10: compact TUI — узкие отступы, тонкие границы, 2-колоночный grid. */

Screen {
    background: $surface;
}

#title {
    color: $accent;
    text-style: bold;
    padding: 0 1;
    text-align: center;
}

#detected-text {
    color: $text-muted;
    background: $boost;
    padding: 0 1;
    margin: 0 1;
    text-align: center;
}

#form-container {
    margin: 0 1;
    padding: 0 1;
    border: tall $primary 30%;
    height: auto;
}

Label.section {
    text-style: bold;
    margin: 1 0 0 0;
    color: $accent;
}

Input {
    margin: 0 0 1 0;
}

Select {
    margin: 0 0 1 0;
}

#service-checkboxes {
    height: auto;
    padding: 0;
    margin: 0;
}

/* Tier card — тонкая граница, плотные внутренности, 2 колонки чекбоксов. */
.tier-group {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 0 2;
    grid-rows: auto;
    border: tall $accent 25%;
    background: $boost;
    margin: 0 0 1 0;
    padding: 0 1;
    height: auto;
}

Label.tier-section {
    text-style: bold;
    color: $accent;
    column-span: 2;
    padding: 0;
    margin: 0;
    width: 100%;
}

.tier-group Checkbox {
    margin: 0;
    padding: 0;
    height: 1;
    width: 100%;
    background: transparent;
    border: none;
}

.tier-group Checkbox:hover {
    background: $primary 20%;
}

.tier-group Checkbox.-on {
    color: $success;
}

#button-row {
    align: center middle;
    margin: 1 0 0 0;
    height: 3;
}

#button-row Button {
    margin: 0 1;
    min-width: 12;
}

#preview-box {
    border: tall $warning 40%;
    padding: 0 1;
    margin: 0 1;
    height: 16;
    overflow: auto;
}

Static.hint {
    color: $text-muted;
    margin: 0;
    padding: 0;
    text-style: italic;
}

#status-msg {
    margin: 0 1;
    padding: 0 1;
    color: $text-muted;
}

#status-msg.success { color: $success; text-style: bold; }
#status-msg.error { color: $error; text-style: bold; }
