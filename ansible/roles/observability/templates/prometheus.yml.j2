# Prometheus config — сгенерировано Ansible.

global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    cluster: agmind
    host: "{{ ansible_hostname }}"

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: cadvisor
    static_configs:
      - targets: ['cadvisor:8080']

  - job_name: llama-llm
    metrics_path: /metrics
    static_configs:
      - targets: ['llama-llm:8080']

  - job_name: llama-embed
    static_configs:
      - targets: ['llama-embed:8080']

  - job_name: qdrant
    static_configs:
      - targets: ['qdrant:6333']

  - job_name: dify-api
    metrics_path: /metrics
    static_configs:
      - targets: ['dify-api:5001']
