# AGmind compose env — generated by the Ansible `services` role. chmod 600 (secrets inside).
#
# This MUST generate every catalog-required ${VAR:?} secret with the SAME value FORMAT the
# Python installer uses (agmind.install.secret_keys): homarr = 64 lowercase hex, the three
# Authelia secrets = 64-char, everything else = 32-char alnum. A missing key crashes the
# role's own `docker compose config` gate; a wrong FORMAT passes compose config but crashes
# the service at boot (the homarr-64-hex landmine). tests/ansible/test_env_j2_completeness.py
# asserts this stays in sync with the descriptor catalog.

MINIO_ROOT_USER=agmind
N8N_TIMEZONE=UTC

# ---- 32-char alnum (DB / cache / object-store / automation / Komodo ops) ----
POSTGRES_PASSWORD={{ lookup('password', agmind_install_dir + '/.postgres_password length=32 chars=ascii_letters,digits') }}
REDIS_PASSWORD={{ lookup('password', agmind_install_dir + '/.redis_password length=32 chars=ascii_letters,digits') }}
GRAFANA_PASSWORD={{ lookup('password', agmind_install_dir + '/.grafana_password length=32 chars=ascii_letters,digits') }}
MINIO_ROOT_PASSWORD={{ lookup('password', agmind_install_dir + '/.minio_password length=32 chars=ascii_letters,digits') }}
MYSQL_ROOT_PASSWORD={{ lookup('password', agmind_install_dir + '/.mysql_root_password length=32 chars=ascii_letters,digits') }}
ELASTIC_PASSWORD={{ lookup('password', agmind_install_dir + '/.elastic_password length=32 chars=ascii_letters,digits') }}
MILVUS_MINIO_ROOT_PASSWORD={{ lookup('password', agmind_install_dir + '/.milvus_minio_root_password length=32 chars=ascii_letters,digits') }}
N8N_ENCRYPTION_KEY={{ lookup('password', agmind_install_dir + '/.n8n_encryption_key length=32 chars=ascii_letters,digits') }}
KOMODO_DATABASE_PASSWORD={{ lookup('password', agmind_install_dir + '/.komodo_database_password length=32 chars=ascii_letters,digits') }}
KOMODO_INIT_ADMIN_PASSWORD={{ lookup('password', agmind_install_dir + '/.komodo_init_admin_password length=32 chars=ascii_letters,digits') }}
KOMODO_JWT_SECRET={{ lookup('password', agmind_install_dir + '/.komodo_jwt_secret length=32 chars=ascii_letters,digits') }}
KOMODO_WEBHOOK_SECRET={{ lookup('password', agmind_install_dir + '/.komodo_webhook_secret length=32 chars=ascii_letters,digits') }}

# ---- Authelia session/storage/jwt secrets — 64-char (Authelia length warnings) ----
AUTHELIA_SESSION_SECRET={{ lookup('password', agmind_install_dir + '/.authelia_session_secret length=64 chars=ascii_letters,digits') }}
AUTHELIA_STORAGE_ENCRYPTION_KEY={{ lookup('password', agmind_install_dir + '/.authelia_storage_encryption_key length=64 chars=ascii_letters,digits') }}
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET={{ lookup('password', agmind_install_dir + '/.authelia_jwt_secret length=64 chars=ascii_letters,digits') }}

# ---- homarr SECRET_ENCRYPTION_KEY: EXACTLY 64 LOWERCASE hex (base64 default aborts boot) ----
HOMARR_SECRET_ENCRYPTION_KEY={{ lookup('password', agmind_install_dir + '/.homarr_secret length=64 chars=digits,abcdef') }}
