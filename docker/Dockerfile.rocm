# syntax=docker/dockerfile:1.7
# AGmind ROCm/HIP backend — SECONDARY на AMD Strix Halo (gfx1151).
# Для GDN-моделей, long-context pp, concurrent batch ≥16, M2 tool calling.
#
# Базовый образ: ROCm 7.2.3-complete (build stage — нужен HIP SDK + LLVM).
# 6.89 GB, содержит rocm-hip-sdk + rocblas + hipblas + headers + cmake.
# Verified 2026-05-19 через Docker Hub registry-1 manifest API.
# Tag schema AMD: MAJOR.MINOR.PATCH[-complete]. Не существует `:X.Y-runtime`
# (community guides upstream используют RPM/Fedora base — см. kyuz0 toolboxes).
#
# Alternative runtime tag (1.13 GB, без LLVM):
#   rocm/dev-ubuntu-24.04:7.2.3@sha256:8ab378c7264c7e15496f548392c518a6b2feeb322d6233364c6c2ebc8e7ffb42
#
# Запуск:
#   docker run --rm \
#     --device=/dev/kfd --device=/dev/dri \
#     --group-add video --group-add render \
#     --security-opt seccomp=unconfined --cap-add=SYS_PTRACE \
#     --ipc=host --shm-size=16G \
#     -e AGMIND_BACKEND=rocm \
#     agmind-rocm:dev
# (rootless Docker не работает с ROCm на cgroups v2 — ROCm/#2860.)
FROM --platform=linux/amd64 rocm/dev-ubuntu-24.04:7.2.3-complete@sha256:ec1b59bf75ec1122e7a091c0be82301ba12458b038499ef96a5c115876bd78d2

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTORCH_ROCM_ARCH=gfx1151 \
    PYTORCH_ALLOC_CONF=expandable_segments:True \
    TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1 \
    ROCBLAS_USE_HIPBLASLT=1 \
    HSA_ENABLE_SDMA=0 \
    HIP_PLATFORM=amd \
    MIOPEN_LOG_LEVEL=3 \
    HIP_VISIBLE_DEVICES=0 \
    ROCR_VISIBLE_DEVICES=0

# ВАЖНО: HSA_OVERRIDE_GFX_VERSION=11.5.1 НЕ ставится — с AMD nightly
# gfx1151 wheels (используются ниже) override вызывает subtle bugs на
# attention/conv kernels (см. R1-pytorch-rocm-docker.md).

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv python3-dev \
        build-essential cmake ninja-build pkg-config git \
        libnuma1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade \
        "pip>=24,<26" \
        "wheel>=0.43,<1" \
        "setuptools>=68,<90"
ENV PATH="/opt/venv/bin:${PATH}"

COPY constraints /opt/agmind/constraints

# PyTorch ROCm: ОБЯЗАТЕЛЬНО AMD nightly index для gfx1151. Stock
# pytorch.org wheels на gfx1151 дают 'HIP error: invalid device function'.
# URL verified HTTP 200 на 2026-05-19 (last-modified тот же день — actively maintained).
# Альтернатива: v2-staging/gfx1151/ (bleeding-edge, но cap 64GB memory).
# ⚠️ Nightly URL может стать недоступным — если build fails, попробовать stable rocm/pytorch.
RUN pip install -c /opt/agmind/constraints/rocm-gfx1151.txt \
        --index-url https://rocm.nightlies.amd.com/v2/gfx1151/ \
        --pre \
        torch torchaudio torchvision

# llama-cpp-python с GGML_HIP (gfx1151-specific build).
# См. R3-llama-cpp-vulkan-hip.md — все CMAKE_ARGS обязательны.
ENV CMAKE_ARGS="-DGGML_HIP=ON \
                -DAMDGPU_TARGETS=gfx1151 \
                -DGPU_TARGETS=gfx1151 \
                -DGGML_HIP_NO_VMM=ON \
                -DGGML_HIP_ROCWMMA_FATTN=ON \
                -DGGML_HIP_MMQ_MFMA=ON \
                -DLLAMA_HIP_UMA=ON \
                -DGGML_NATIVE=OFF \
                -DCMAKE_BUILD_TYPE=Release" \
    FORCE_CMAKE=1 \
    HIPCXX=/opt/rocm/llvm/bin/clang \
    HIP_PATH=/opt/rocm
RUN pip install -c /opt/agmind/constraints/rocm-gfx1151.txt \
        --no-binary llama-cpp-python \
        "llama-cpp-python>=0.3.23,<0.4"

# onnxruntime CPU only (onnxruntime-rocm 1.22.x НЕ gfx1151-ready).
RUN pip install -c /opt/agmind/constraints/rocm-gfx1151.txt onnxruntime numpy scipy

WORKDIR /opt/agmind
COPY . /opt/agmind
RUN pip install -c /opt/agmind/constraints/rocm-gfx1151.txt -e ".[rocm]"

ENV AGMIND_BACKEND=rocm \
    AGMIND_ENGINE=llama_cpp

HEALTHCHECK --interval=60s --timeout=15s --start-period=30s --retries=3 \
    CMD python3 -c "from agmind.compute import get_backend; b = get_backend(); assert b.name == 'rocm'" \
    || exit 1

ENTRYPOINT ["python3", "-m", "agmind"]
