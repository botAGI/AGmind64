# syntax=docker/dockerfile:1.7
# AGmind CPU backend — fallback для x86_64 без AMD GPU.
ARG BASE_IMAGE=agmind-base:dev
FROM ${BASE_IMAGE}

COPY constraints /opt/agmind/constraints

# PyTorch CPU-only + llama-cpp-python CPU build + onnxruntime CPU
RUN pip install -c /opt/agmind/constraints/cpu.txt \
        --index-url https://download.pytorch.org/whl/cpu \
        torch torchvision torchaudio \
    && pip install -c /opt/agmind/constraints/cpu.txt \
        onnxruntime \
        "llama-cpp-python>=0.3.23,<0.4" \
        numpy scipy

COPY . /opt/agmind
RUN pip install -c /opt/agmind/constraints/cpu.txt -e ".[cpu]"

ENV AGMIND_BACKEND=cpu

ENTRYPOINT ["python3", "-m", "agmind"]
