{
  "$defs": {
    "AccessConfig": {
      "additionalProperties": false,
      "description": "Operator access metadata for a web-UI / model-endpoint service.\n\nDrives the post-install summary, ``credentials.txt``, and the ``agmind endpoints`` /\n``agmind creds show`` commands. The URL comes from :class:`RoutingConfig`; secret *values*\ncome from the rendered ``.env`` (resolved via ``password_env``) and are never stored here.",
      "properties": {
        "login": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Login"
        },
        "password_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password Env"
        },
        "first_login_register": {
          "default": false,
          "title": "First Login Register",
          "type": "boolean"
        },
        "lan_only": {
          "default": false,
          "title": "Lan Only",
          "type": "boolean"
        },
        "api_kind": {
          "anyOf": [
            {
              "const": "openai",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Kind"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "AccessConfig",
      "type": "object"
    },
    "HealthCheck": {
      "additionalProperties": false,
      "description": "Docker healthcheck definition (compose v3 format).\n\nИспользуется тремя потребителями (deep-dive 04 §5):\n- Docker compose: для restart logic\n- Traefik: для исключения unhealthy из роутинга\n- Prometheus blackbox: для алертинга",
      "properties": {
        "test": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Test",
          "type": "array"
        },
        "interval": {
          "default": "30s",
          "title": "Interval",
          "type": "string"
        },
        "timeout": {
          "default": "5s",
          "title": "Timeout",
          "type": "string"
        },
        "retries": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Retries",
          "type": "integer"
        },
        "start_period": {
          "default": "10s",
          "title": "Start Period",
          "type": "string"
        }
      },
      "required": [
        "test"
      ],
      "title": "HealthCheck",
      "type": "object"
    },
    "ObservabilityConfig": {
      "additionalProperties": false,
      "description": "Auto-discovery hints для observability stack.\n\nИдея: один лейбл в compose → Prometheus/Loki сам подхватывает.\nСм. deep-dive 04 §3-§4 и deep-dive 03 §7.",
      "properties": {
        "prometheus_scrape": {
          "default": false,
          "title": "Prometheus Scrape",
          "type": "boolean"
        },
        "metrics_path": {
          "default": "/metrics",
          "title": "Metrics Path",
          "type": "string"
        },
        "metrics_port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metrics Port"
        },
        "loki_scrape": {
          "default": true,
          "title": "Loki Scrape",
          "type": "boolean"
        },
        "grafana_dashboard": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grafana Dashboard"
        }
      },
      "title": "ObservabilityConfig",
      "type": "object"
    },
    "ResourceLimits": {
      "additionalProperties": false,
      "description": "CPU/memory limits для Docker.",
      "properties": {
        "cpus": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 64,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpus"
        },
        "mem_limit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mem Limit"
        }
      },
      "title": "ResourceLimits",
      "type": "object"
    },
    "RoutingConfig": {
      "additionalProperties": false,
      "description": "Traefik routing метаданные.\n\nЕсли None — сервис не публикуется через Traefik (internal-only).",
      "properties": {
        "host": {
          "minLength": 3,
          "title": "Host",
          "type": "string"
        },
        "middleware_chain": {
          "default": "chain-internal",
          "enum": [
            "chain-llm",
            "chain-internal",
            "chain-public"
          ],
          "title": "Middleware Chain",
          "type": "string"
        },
        "sse": {
          "default": false,
          "title": "Sse",
          "type": "boolean"
        },
        "healthcheck_path": {
          "default": "/health",
          "title": "Healthcheck Path",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "path_prefixes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Path Prefixes",
          "type": "array"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        }
      },
      "required": [
        "host"
      ],
      "title": "RoutingConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Single source of truth для одного сервиса (Phase H' artifact).\n\nПарсится из `templates/services/<name>.yaml`, рендерится в Docker Compose\n+ Traefik labels + Prometheus scrape + Loki labels автоматически.\n\nПример минимального файла:\n\n    # yaml-language-server: $schema=../schemas/service.json\n    name: qdrant\n    image: qdrant/qdrant:v1.18.0\n    tier: storage\n    purpose: Vector store\n    ports:\n      - \"127.0.0.1:6333:6333\"",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "image": {
      "title": "Image",
      "type": "string"
    },
    "digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Digest"
    },
    "tier": {
      "enum": [
        "edge",
        "inference",
        "app",
        "storage",
        "ops"
      ],
      "title": "Tier",
      "type": "string"
    },
    "purpose": {
      "default": "",
      "title": "Purpose",
      "type": "string"
    },
    "owner": {
      "default": "agmind-core",
      "title": "Owner",
      "type": "string"
    },
    "profiles": {
      "items": {
        "type": "string"
      },
      "title": "Profiles",
      "type": "array"
    },
    "ports": {
      "items": {
        "type": "string"
      },
      "title": "Ports",
      "type": "array"
    },
    "networks": {
      "items": {
        "type": "string"
      },
      "title": "Networks",
      "type": "array"
    },
    "volumes": {
      "items": {
        "type": "string"
      },
      "title": "Volumes",
      "type": "array"
    },
    "env": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Env",
      "type": "object"
    },
    "extra_args": {
      "items": {
        "type": "string"
      },
      "title": "Extra Args",
      "type": "array"
    },
    "command": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command"
    },
    "devices": {
      "items": {
        "type": "string"
      },
      "title": "Devices",
      "type": "array"
    },
    "group_add": {
      "items": {
        "type": "string"
      },
      "title": "Group Add",
      "type": "array"
    },
    "security_opt": {
      "items": {
        "type": "string"
      },
      "title": "Security Opt",
      "type": "array"
    },
    "cap_add": {
      "items": {
        "type": "string"
      },
      "title": "Cap Add",
      "type": "array"
    },
    "cap_drop": {
      "items": {
        "type": "string"
      },
      "title": "Cap Drop",
      "type": "array"
    },
    "read_only": {
      "default": false,
      "title": "Read Only",
      "type": "boolean"
    },
    "pids_limit": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pids Limit"
    },
    "no_new_privileges": {
      "default": false,
      "title": "No New Privileges",
      "type": "boolean"
    },
    "cgroupns_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cgroupns Mode"
    },
    "privileged": {
      "default": false,
      "title": "Privileged",
      "type": "boolean"
    },
    "depends_on": {
      "items": {
        "type": "string"
      },
      "title": "Depends On",
      "type": "array"
    },
    "provides": {
      "items": {
        "type": "string"
      },
      "title": "Provides",
      "type": "array"
    },
    "conflicts_with": {
      "items": {
        "type": "string"
      },
      "title": "Conflicts With",
      "type": "array"
    },
    "consumes": {
      "items": {
        "type": "string"
      },
      "title": "Consumes",
      "type": "array"
    },
    "resources": {
      "$ref": "#/$defs/ResourceLimits"
    },
    "health": {
      "anyOf": [
        {
          "$ref": "#/$defs/HealthCheck"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "routing": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoutingConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "access": {
      "anyOf": [
        {
          "$ref": "#/$defs/AccessConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observability": {
      "$ref": "#/$defs/ObservabilityConfig"
    },
    "run_as_uid": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run As Uid"
    },
    "run_as_gid": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run As Gid"
    },
    "writable_mounts": {
      "items": {
        "type": "string"
      },
      "title": "Writable Mounts",
      "type": "array"
    }
  },
  "required": [
    "name",
    "image",
    "tier"
  ],
  "title": "AGmind Service Descriptor",
  "type": "object",
  "$id": "https://github.com/botAGI/AGmind64/schemas/service.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
